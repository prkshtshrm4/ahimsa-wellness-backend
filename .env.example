# ─── Ahimsa Wellness backend environment ────────────────────────────────
# Copy to .env and fill in. Sensible defaults let the app run out of the box.

# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB (Railway proxy connection string provided by the centre)
MONGODB_URI=mongodb://mongo:FljJvBHmJeDxTdFsBYCNsybxPRFaLvxC@reseau.proxy.rlwy.net:52293/admin?authSource=admin

# Firebase — the project the client authenticates against.
# Backend verifies ID tokens against Google's public keys using only the projectId,
# so no service-account file is required for token verification.
FIREBASE_PROJECT_ID=ahimsa-wellness

# Auth mode: firebase (production) — only real Firebase ID tokens accepted.
AUTH_MODE=firebase

# Razorpay test or live keys (required for pay-now checkout).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
